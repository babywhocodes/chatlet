{
  "expo": {
    "name": "chatlet",
    "slug": "chatlet",
    "scheme": "com.babywhocodes.chatlet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babywhocodes.chatlet"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.babywhocodes.chatlet",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-router",
     [
  "expo-build-properties",
  {
    "android": {
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "extraProguardRules": "-dontwarn com.stripe.android.pushProvisioning.**\n-keep class com.stripe.android.pushProvisioning.** { *; }\n-dontwarn org.checkerframework.**\n-dontwarn javax.annotation.**\n-dontwarn com.google.errorprone.annotations.**\n-dontwarn com.google.android.gms.**\n-keep class com.google.android.gms.** { *; }"
    }
  }
]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07a8873c-56c7-48ec-a95c-7bcdb1c6108d"
      }
    },
    "cli": {
      "appVersionSource": "remote"
    }
  }
}
